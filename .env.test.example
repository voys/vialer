# Codemagic will only import these environment variables for builds running integration tests. They
# will not be included in production builds.
#
# The SIP account baresip uses (INTEGRATION_TEST_SIP_USER/PASS) is deliberately not listed: only
# the build machine needs it, and everything in .env is bundled into the app.
INTEGRATION_TEST_USER_1_USERNAME=
INTEGRATION_TEST_USER_1_PASSWORD=
INTEGRATION_TEST_USER_WITHOUT_APP_ACCOUNT_USERNAME=
INTEGRATION_TEST_USER_WITHOUT_APP_ACCOUNT_PASSWORD=
INTEGRATION_TEST_CALLING_PHONE_NUMBER=
INTEGRATION_TEST_INCOMING_CALL_NUMBER=
