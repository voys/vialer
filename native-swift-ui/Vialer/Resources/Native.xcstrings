    "native.changePassword.requirements": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "At least 6 characters including a non-alphanumeric character. Changing your password invalidates existing API tokens, so you will need to log in again."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimaal 6 tekens, waarvan één niet-alfanumeriek teken. Als je je wachtwoord wijzigt, vervallen bestaande API-tokens en moet je opnieuw inloggen."
          }
        }
      }
    },
