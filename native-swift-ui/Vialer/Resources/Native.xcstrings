    "native.call.failed.rejectedByCallKit": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The call was rejected by iOS. Check that calls are allowed in Focus or Screen Time settings."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De oproep is geweigerd door iOS. Controleer of bellen is toegestaan in de instellingen van Focus of Schermtijd."
          }
        }
      }
    },
