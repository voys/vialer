    "main.contacts.list.noPermission.description(String appName)" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "$appName benötigt die Erlaubnis, deine Kontakte anzuzeigen."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$appName needs permission to display your contacts."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$appName necesita permiso para mostrar tus contactos."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$appName a besoin d'une autorisation pour afficher vos contacts."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$appName heeft jouw toestemming nodig om je contacten weer te geven."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$appName precisa de permissão para mostrar os seus contactos."
          }
        }
      }
    },
    "main.contacts.list.noPermission.permanentDescription(String appName)" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Um deine Kontakte anzuzeigen, musst du der App erlauben, dies zu tun. Du hast diese Erlaubnis noch nicht erteilt. Bitte gehe zu den Datenschutzeinstellungen deines Telefons und erlaube $appName den Zugriff auf deine Kontakte."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In order to display your contacts, you need to allow the app to do so. You haven't given this permission yet. Please go to your phone privacy settings and allow $appName to access your contacts."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para poder mostrar tus contactos, tienes que dar permiso a la aplicación. Aún no has dado este permiso. Ve a la configuración de privacidad de tu teléfono y permite que $appName acceda a tus contactos."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour afficher vos contacts, vous devez autoriser l'app à y accéder. Vous n'avez pas encore accordé cette autorisation. Veuillez aller dans les paramètres de confidentialité de votre téléphone et autoriser $appName à vos contacts."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$appName heeft jouw toestemming nodig om je contacten weer te geven. Je hebt deze toestemming nog niet gegeven. Ga naar de privacy-instellingen van je telefoon om daar $appName alsnog toegang tot je contacten te geven."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para apresentar os seus contactos, tem de conceder permissão à aplicação. Ainda concedeu essa permissão. Aceda às definições de privacidade do seu telefone e permita que $appName aceda aos seus contactos."
          }
        }
      }
    },
