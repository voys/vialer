    "main.notice.notifications.content" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Ohne die Erlaubnis für Benachrichtigungen verpasst du möglicherweise wichtige Informationen wie beispielsweise verpasste oder eingehende Anrufe."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without notifications permission, you might miss important information such as missed or incoming calls."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin el permiso de Notificaciones, podrías perderte información importante, como llamadas perdidas o entrantes."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans autorisation de notification, vous risquez de manquer des informations importantes telles que les appels manqués ou entrants."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder toestemming tot notificaties is het mogelijk dat je belangrijke informatie mist, zoals gemiste of inkomende gesprekken."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem a permissão de notificações, pode perder informações importantes, como chamadas perdidas ou recebidas."
          }
        }
      }
    },
