    "main.settings.list.calling.callDirectoryExtension.description(String appName)" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Zeigt den Namen eines gemeinsamen Kontakts an, wenn Sie Anrufe an Ihre persönliche Handynummer erhalten. $appName muss als \"Anrufidentifizierungs-App\" konfiguriert sein."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Display the name of a shared contact when receiving calls to your personal mobile number. $appName must be configured as a \"Call Identification App\"."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el nombre de un contacto compartido al recibir llamadas a tu número de móvil personal. $appName debe configurarse como \"App de identificación de llamadas\"."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche le nom d'un contact partagé lors de la réception d'appels vers votre numéro de téléphone mobile personnel. L'application $appName doit être configurée en tant qu'\"application d'identification des appels\"."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De naam van een gedeeld contact weergeven bij het ontvangen van oproepen op je persoonlijke mobiele nummer. $appName moet worden geconfigureerd als een \"Oproepidentificatie-app\"."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apresenta o nome de um contacto partilhado quando recebe chamadas no seu número de telefone pessoal. $appName tem de estar configurada como uma \"Aplicação de identificação de chamadas\"."
          }
        }
      }
    },
