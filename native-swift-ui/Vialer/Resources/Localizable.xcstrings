    "onboarding.permission.bluetooth.description(String appName)" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Du rufst mit deinem standardmäßigen Bluetooth-Headset oder Lautsprecher an, wenn diese angeschlossen sind.\n\nWenn du $appName erlaubst, kannst du auch andere Bluetooth-Geräte auswählen."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll call with your default Bluetooth headset or speaker when it's connected.\n\nIf you allow $appName permission, you can also select other Bluetooth devices."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llamarás con tu auricular o altavoz Bluetooth predeterminado cuando esté conectado.\n\nSi permites el permiso $appName, también puedes seleccionar otros dispositivos Bluetooth."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous appelez avec votre casque ou haut-parleur Bluetooth par défaut lorsqu'il est connecté.\n\nSi vous autorisez l'autorisation $appName, vous pouvez également sélectionner d'autres appareils Bluetooth."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je belt met jouw standaard Bluetooth-headset of -luidspreker wanneer deze is verbonden.\n\nAls je Bluetooth-rechten toestaat aan $appName, kun je ook andere Bluetooth-apparaten selecteren."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chamada será efetuada com o auscultador ou altifalante Bluetooth predefinido quando estiver associado.\n\nSe conceder permissão a $appName, também pode selecionar outros dispositivos Bluetooth."
          }
        }
      }
    },
