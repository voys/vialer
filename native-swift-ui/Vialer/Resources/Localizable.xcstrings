    "rateLimiting.snackbar.message(String appName, String seconds)" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "$appName konnte die Einstellung nicht speichern. Entschuldigung, bitte versuche es in $seconds Sekunden noch einmal."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$appName could not save the setting. Sorry, please try again in $seconds seconds."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$appName no ha podido guardar la configuración. Lo sentimos, inténtalo de nuevo en $seconds segundos."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$appName n'a pas pu enregistrer le paramètre. Désolé, veuillez réessayer dans $seconds secondes."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$appName kan de instelling niet opslaan. Sorry, probeer het over $seconds seconden opnieuw."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$appName não conseguiu guardar a definição. Desculpe, tente novamente em $seconds segundos."
          }
        }
      }
    },
