    "main.dialer.noPermission.description(String appName)" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Deine Erlaubnis ist erforderlich, um über $appName anzurufen. Bitte tippe auf Erlauben, wenn du aufgefordert wirst, der App das Tätigen und Verwalten von Anrufen zu erlauben, damit sie ordnungsgemäß funktionieren kann."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your permission is required to call via $appName. Please tap Allow when asked to allow it to make and manage phone calls, so that the app can work properly."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se requiere tu permiso para llamar a través de $appName. Por favor, pulsa Permitir cuando te pregunten para permitir realizar y gestionar llamadas telefónicas de forma que la aplicación funcione correctamente."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre autorisation est requise pour appeler via $appName. Veuillez appuyer sur Autoriser lorsque cela vous est demandé pour permettre à l'application de passer et gérer des appels téléphoniques, afin qu'elle fonctionne correctement"
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om via $appName te bellen is jouw toestemming nodig. Tik hierna op Toestaan als je wilt dat $appName gesprekken kan opzetten en beheren, zodat de app goed werkt."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É necessária a sua permissão para efetuar chamadas através de $appName. Toque em Permitir quando lhe for pedido que permita efetuar e gerir chamadas telefónicas, para que a aplicação possa funcionar corretamente."
          }
        }
      }
    },
    "main.dialer.noPermission.permanentDescription(String appName)" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Deine Erlaubnis ist erforderlich, um über $appName anzurufen. Du hast diese Erlaubnis noch nicht erteilt. Bitte gehe in die Datenschutzeinstellungen deines Telefons und genehmige die „Telefon“-Erlaubnis."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your permission is required to call via $appName. You haven't given this permission yet. Please go to your phone's privacy settings and allow the “Phone” permission for $appName."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se requiere tu permiso para llamar a través de $appName. Aún no has dado este permiso. Por favor, ve a la configuración de privacidad de tu teléfono y permite el permiso \"Teléfono\" para $appName."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre autorisation est requise pour appeler via $appName. Vous n'avez pas encore accordé cette autorisation. Veuillez vous rendre dans les paramètres de confidentialité de votre téléphone et autoriser l'option \"Téléphone\" pour $appName."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om via $appName te bellen is jouw toestemming nodig. Je hebt deze toestemming nog niet gegeven waardoor je niet kunt bellen. Ga naar de privacy-instellingen van je telefoon om daar $appName alsnog toegang te geven tot de \"Telefoon\"-rechten."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É necessária a sua permissão para efetuar chamadas através de $appName. Ainda não concedeu esta permissão. Aceda às definições de privacidade do seu telefone e conceda a permissão \"Telefone\" para $appName."
          }
        }
      }
    },
    "main.dialer.noPermission.title" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Bitte gib deine Erlaubnis"
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please give your permission"
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por favor, da tu permiso"
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez donner votre permission"
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graag je toestemming geven"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conceda a sua permissão"
          }
        }
      }
    },
    "main.dialer.permissionDenied" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Die für Direktanrufe erforderliche Telefonerlaubnis wurde verweigert."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Phone permission is denied, which is required to make direct calls."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se denegó el permiso Teléfono, necesario para realizar llamadas directas."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'autorisation d'accès au téléphone est refusée. Elle est nécessaire pour passer des appels directs."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
