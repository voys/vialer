    "main.survey.messagingApps.disclaimer" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Wenn Sie fortfahren, erklären Sie sich damit einverstanden, dass wir Ihre Antworten und Ihr Benutzerprofil für interne Analysen und die Produktentwicklung verwenden."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By continuing, you agree that we'll use your answers and user profile for internal analysis and product development."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al continuar, aceptas que utilicemos tus respuestas y tu perfil de usuario para análisis internos y desarrollo de productos."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En continuant, vous acceptez que nous utilisions vos réponses et votre profil d'utilisateur à des fins d'analyse interne et de développement de produits."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Door door te gaan, ga je ermee akkoord dat we je antwoorden en gebruikersprofiel gebruiken voor interne analyse en productontwikkeling."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao continuar, concorda que utilizaremos as suas respostas e o seu perfil de utilizador para análise interna e desenvolvimento de produtos."
          }
        }
      }
    },
    "main.survey.messagingApps.intro(String username)" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Hallo $username!\n\nGroße Neuigkeiten - wir arbeiten an etwas Neuem! Mit deiner Hilfe können wir es so gestalten, dass es perfekt zu dir und deinem Unternehmen passt.\n\nTippe auf die Schaltfläche unten, um unsere 30-sekündige Umfrage zu starten."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hey there, $username!\n\nBig news – we're crafting something new! With your help, we can build it to perfectly fit you and your business.\n\nTap the button below to start our 30-second survey."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Hola, $username!\n\nGrandes noticias: ¡estamos creando algo nuevo! Con tu ayuda, podemos construirlo para que se adapte perfectamente a ti y a tu negocio.\n\nPulsa el botón de abajo para empezar nuestra encuesta de 30 segundos."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salut $username !\n\nGrande nouvelle - nous créons quelque chose de nouveau ! Avec votre aide, nous pouvons l'adapter parfaitement à vous et à votre entreprise.\n\nAppuyez sur le bouton ci-dessous pour commencer notre enquête de 30 secondes."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoi $username!\n\nGroot nieuws - we maken iets nieuws! Met jouw hulp kunnen we het zo maken dat het perfect bij jou en je bedrijf past.\n\nTik op de knop hieronder om onze 30-seconden durende enquête te starten."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olá, $username!\n\nGrandes notícias - estamos a criar algo novo! Com a sua ajuda, podemos criá-lo para se adaptar perfeitamente a si e ao seu negócio.\n\nToque no botão abaixo para iniciar o nosso inquérito de 30 segundos."
          }
        }
      }
    },
