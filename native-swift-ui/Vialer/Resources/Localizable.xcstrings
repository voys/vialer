    "main.settings.list.advancedSettings.troubleshooting.list.audio.echoCancellationCalibration.description" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Drücke diese Taste, um einen kurzen Prozess zur Kalibrierung der Echokompensation zu starten. Während dies geschieht, hörst du eine Serie von Pieptönen. Wenn die Signaltöne aufhören, ist die Kalibrierung abgeschlossen."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press to start a short process that will calibrate echo cancellation, you will hear a series of beeps while this is happening. When the beeps stop the calibration has completed."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa para iniciar un breve proceso que calibrará la cancelación de eco. Oirás una serie de pitidos mientras esto sucede. Cuando dejen de sonar, la calibración habrá finalizado."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez pour démarrer un processus rapide qui calibrera l'annulation d'écho. Vous entendrez une série de bips pendant le processus. La calibration est terminée lorsque les bips s'arrêtent."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik om een kort proces te beginnen om echo cancellation te kalibreren, je hoort een aantal geluiden terwijl dit gebeurt. Wanneer de geluiden zijn gestopt is het kalibreren klaar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione para iniciar um processo curto que irá calibrar o cancelamento de eco, ouvirá uma série de sinais sonoros enquanto isto está a acontecer. Quando os sinais sonoros pararem, a calibração está concluída."
          }
        }
      }
    },
    "main.settings.list.advancedSettings.troubleshooting.list.audio.echoCancellationCalibration.title" : {
      "localizations" : {
