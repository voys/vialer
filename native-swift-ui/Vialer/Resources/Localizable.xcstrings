    "onboarding.permission.contacts.description(String appName)" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Mit dieser Erlaubnis kann $appName deine Kontakte und den Anrufverlauf anzeigen und es dir ermöglichen, sie zu durchsuchen.\n\n$appName speichert deine Kontakte sicher nur auf deinem Telefon und ermöglicht die Suche und Verwaltung von Kontakten.\n\nWir geben keine Kontaktinformationen an Dritte weiter."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This permission allows $appName to collect your contacts when you initiate a call. The app sends the phone number to our telephony servers to connect your call. It also shows your contacts, so you can search through them easily and view call history.\n\n$appName securely stores your contacts only on your phone, enabling contact searching and management.\n\nWe do not share any contact information with third parties."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este permiso permite a $appName recopilar tus contactos cuando inicias una llamada. La aplicación envía el número de teléfono a nuestros servidores de telefonía para conectar tu llamada. También muestra tus contactos, para que puedas buscarlos fácilmente y ver el historial de llamadas.\n\n$appName almacena de forma segura tus contactos solo en tu teléfono, lo que permite la búsqueda y gestión de contactos.\n\nNo compartimos ninguna información de contacto con terceros."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette autorisation permet à $appName d'afficher vos contacts, l'historique des appels et vous permet de les rechercher.\n\n$appName stocke en toute sécurité vos contacts uniquement sur votre téléphone, permettant la recherche et la gestion des contacts.\n\nNous ne partageons aucune information de contact avec des tiers."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Door toestemming te geven mag $appName je contacten verzamelen wanneer je deze belt. De app stuurt het telefoonnummer naar onze servers om jouw gesprek op te zetten. Je kunt dan ook je contacten makkelijk doorzoeken en recente gesprekken bekijken.\n\n$appName bewaart jouw contacten veilig en alleen op jouw telefoon, zodat je contacten kunt vinden en beheren.\n\nWe delen geen contactgegevens met derden."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta permissão permite que $appName recolha os seus contactos quando inicia uma chamada. A aplicação envia o número de telefone para os nossos servidores de telefonia para estabelecer a sua chamada. Também mostra os seus contactos, para que possa pesquisá-los facilmente e ver o histórico de chamadas.\n\nA $appName armazena de forma segura os seus contactos apenas no seu telefone, o que permite a pesquisa e a gestão de contactos.\n\nNão partilhamos quaisquer informações de contacto com terceiros."
          }
        }
      }
    },
    "onboarding.permission.contacts.title" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Kontakte-Erlaubnis"
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contacts permission"
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorización de Contactos"
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisation des contacts"
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toestemming voor contacten"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permissão de contactos"
          }
        }
      }
    },
    "onboarding.permission.ignoreBatteryOptimizations.description(String appName)" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Die Akku-Optimierung kann die App lautlos herunterfahren, eingehende Anrufe und Benachrichtigungen blockieren usw.\n\nMit dieser Erlaubnis wird $appName in die Whitelist aufgenommen, um derartige Probleme zu verhindern.\t\n\nWir sind uns bewusst, wie wichtig der Akku ist und gehen sehr sparsam damit um."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Battery optimization may silently shut down the app, block incoming calls and notifications, etc.\n\nThis permission will whitelist $appName to prevent such issues.\n\nWe are aware how important battery is and use it very conservatively."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La optimización de la batería puede cerrar la aplicación de forma silenciosa, bloquear las llamadas entrantes y las notificaciones, etc.\n\nEste permiso pondrá $appName en la lista blanca para evitar estos problemas.\n\nSomos conscientes de lo importante que es la batería y la utilizamos de forma muy conservadora."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'optimisation de la batterie peut arrêter silencieusement l'app, bloquer les appels entrants et les notifications, etc.\n\nCette autorisation ajoutera $appName à la liste blanche pour éviter de tels problèmes.\n\nNous sommes conscients de l'importance de la batterie et l'utilisons de manière très prudente."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batterij-optimalisatie kan ervoor zorgen dat de app langzaam wordt gestopt, gesprekken en notificaties worden geblokkeerd etc.\n\nDeze toestemming zorgt ervoor dat $appName als veilig wordt gemarkeerd, waardoor dit gedrag zich niet voor zal doen.\n\nWe zijn ons ervan bewust hoe belangrijk je batterij is en gaan hier dan ook zuinig mee om."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A otimização da bateria poderá fechar silenciosamente a aplicação, bloquear as chamadas e notificações recebidas, entre outros.\n\nEsta permissão irá colocar $appName na lista branca para evitar estes problemas.\n\nEstamos cientes da importância da bateria e utilizamos a mesma de forma muito conservadora."
          }
        }
      }
    },
    "onboarding.permission.ignoreBatteryOptimizations.title" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Akku-Optimierung"
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Battery Optimization"
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimización de la batería"
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimisation de la batterie"
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batterij-optimalisatie"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otimização da bateria"
          }
        }
      }
    },
    "onboarding.permission.microphone.description(String appName)" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "$appName erfordert den Zugriff auf das Mikrofon, damit du Anrufe tätigen und entgegennehmen kannst."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$appName needs access to the microphone so you can make and receive calls."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$appName necesita acceso al micrófono para poder hacer y recibir llamadas."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$appName a besoin d'accéder au microphone pour que vous puissiez passer et recevoir des appels."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$appName heeft toegang tot de microfoon nodig zodat je gesprekken op kunt zetten en ontvangen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$appName precisa de acesso ao microfone para possa efetuar e receber chamadas."
          }
        }
      }
    },
    "onboarding.permission.microphone.title" : {
