    "onboarding.permission.notifications.description(String appName)" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "$appName kann Ihnen Benachrichtigungen über verpasste Anrufe senden.\n\nEs ist daher sinnvoll, die Erlaubnis dafür zu erteilen. Du wirdst immer über eingehende Anrufe benachrichtigt, auch ohne diese Erlaubnis."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$appName can send you notifications for missed calls.\n\nIt is therefore useful to give permission for this. You will always be notified of incoming calls, even without this permission."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si quieres que $appName pueda enviarte notificaciones de llamadas perdidas necesitamos tu permiso.\n\nSiempre te notificaremos de las llamadas entrantes, incluso sin este permiso."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$appName peut vous envoyer des notifications pour les appels manqués.\n\nIl est donc utile d'en donner l'autorisation. Vous serez toujours averti des appels entrants, même sans cette autorisation."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$appName kan je een notificatie sturen bij een gemiste oproep.\n\n\nHet is daarom handig hier toestemming voor te geven. Je ontvangt sowieso notificaties bij inkomende oproepen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$appName pode enviar-lhe notificações de chamadas não atendidas.\n\nPor isso, é útil conceder permissão para tal. Receberá sempre uma notificação das chamadas recebidas, mesmo sem esta permissão."
          }
        }
      }
    },
    "onboarding.permission.notifications.title" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Benachrichtigungen"
          }
        },
        "en-US" : {
          "stringUnit" : {
