    "main.settings.list.debug.remoteLogging.sendToRemoteDialog.description" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Wenn du Probleme hast, ist es hilfreich, auch die heutige Aktivität der App zu teilen. Dies hilft dem Team, deine Probleme genauer zu untersuchen."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you're experiencing issues, it's helpful to share today's app activity as well. This helps the team to investigate your issues more closely."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tienes problemas, es útil que compartas también la actividad de la aplicación de hoy. Esto ayuda al equipo a investigar tus problemas más en detalle."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous rencontrez des problèmes, il est également utile de partager l'activité de l'app d'aujourd'hui. Cela aide l'équipe à étudier vos problèmes de manière plus approfondie."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je problemen ervaart, is het handig om ook je app-activiteit van vandaag te delen. Dit helpt het team om je problemen nader te onderzoeken."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se estiver a ter problemas, é útil partilhar também a atividade de hoje da aplicação. Isto ajuda a equipa a investigar os seus problemas mais detalhadamente."
          }
        }
      }
    },
