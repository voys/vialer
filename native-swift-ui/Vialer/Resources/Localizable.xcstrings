    "main.colltacts.contacts.limitedPermission.description(String appName)" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "$appName zeigt nur die Kontakte an, für die Sie eine Importgenehmigung erteilt haben. Sie können jederzeit Kontakte hinzufügen, indem Sie diese Berechtigungen ändern."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "$appName only shows contacts you gave it permission to import. You can add contacts by changing those permissions at any time."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "$appName sólo muestra los contactos que le diste permiso para importar. Puedes añadir contactos cambiando esos permisos en cualquier momento."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "$appName n'affiche que les contacts que vous lui avez permis d'importer. Vous pouvez ajouter des contacts en modifiant ces autorisations à tout moment."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "$appName toont alleen contactpersonen die je toestemming hebt gegeven om te importeren. U kunt contactpersonen toevoegen door deze rechten op elk gewenst moment te wijzigen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "$appName mostra apenas os contactos que lhe deu permissão para importar. Pode adicionar contactos alterando essas permissões em qualquer altura."
          }
        }
      }
    },
