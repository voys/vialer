    "main.call.error.callThrough.numberTooLong.numberTooLong" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Es können nur Rufnummern mit bis zu 17 Ziffern gewählt werden. Bitte überprüfe die gewählte Nummer und versuche es erneut."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only phone numbers with a maximum of 17 digits can be called. Please check the dialed number and try again."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sólo se puede llamar a números de teléfono con un máximo de 17 dígitos. Por favor, compruebe el número marcado e inténtelo de nuevo."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "stale",
