    "onboarding.passwordForgotten.description" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Hast du dein Passwort vergessen? Gib deine E-Mail-Adresse ein und wir senden dir eine E-Mail mit Anweisungen, wie du dein Passwort zurücksetzen kannst."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Did you forget your password? Fill in your email address, and we will email instructions for resetting your password."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Has olvidado tu contraseña? Introduce tu dirección de correo electrónico y te enviaremos instrucciones para restablecerla."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avez-vous oublié votre mot de passe? Remplissez votre adresse e-mail et nous vous enverrons par e-mail des instructions pour réinitialiser votre mot de passe."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ben je je wachtwoord vergeten? Vul je e-mailadres in en we sturen je een e-mail met daarin instructies voor het opnieuw instellen van je wachtwoord."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esqueceu-se da sua palavra-passe? Introduza o seu endereço de e-mail e enviaremos por instruções por e-mail para repor a sua palavra-passe."
          }
        }
      }
    },
