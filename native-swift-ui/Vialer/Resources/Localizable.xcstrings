          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quieres enviar también la actividad de tu aplicación $appName? De este modo ayudarás a nuestros desarrolladores a resolver más rápidamente cualquier problema que tengas."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Souhaitez-vous également envoyer l'activité de votre application $appName? Cela aidera vraiment nos développeurs à résoudre plus rapidement tous les problèmes que vous rencontrez."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wil je ook je $appName app-activiteit versturen? Daarmee help je onze ontwikkelaars echt om eventuele problemen die je ervaart sneller op te lossen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
