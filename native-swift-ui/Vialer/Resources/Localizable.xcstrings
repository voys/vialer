    "main.call.feedback.rating.semantics.title" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Wie war die Gesprächsqualität? Bewerten Sie von einem Stern für sehr schlecht bis zu fünf Sternen für ausgezeichnete Gesprächsqualität."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How was the call quality? Rate from one star for very poor up to five stars for excellent call quality."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué tal la calidad de la llamada? Puntúe desde una estrella para una calidad de llamada muy mala hasta cinco estrellas para una calidad excelente."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment était la qualité de l'appel ? Attribuez une note allant d'une étoile pour une qualité d'appel très médiocre à cinq étoiles pour une qualité d'appel excellente."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe was de gesprekskwaliteit? Beoordeel met één ster voor zeer slecht tot vijf sterren voor uitstekende gesprekskwaliteit."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como foi a qualidade da chamada? Classifique de uma estrela, para uma qualidade de chamada muito fraca, a cinco estrelas, para uma qualidade de chamada excelente."
          }
        }
      }
    },
