          }
        }
      }
    },
    "main.notice.microphone.content(String appName)" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Wenn du keinen Zugriff auf das Mikrofon hast, hörst du beim Anrufen keinen Ton. Bitte aktiviere die \"Mikrofon\"-Erlaubnis für $appName."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without access to the microphone, you don't hear audio when calling. Please allow \"Microphone\" permission for $appName."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin acceso al micrófono no se oye audio al llamar. Por favor, permite el permiso \"Micrófono\" para $appName."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans accès au microphone, vous n'entendez pas de son lorsque vous appelez. Veuillez autoriser l'autorisation \"Microphone\" pour $appName."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder toegang tot de microfoon hoor je geen geluid tijdens gesprekken. Graag $appName toegang geven tot de \"Microfoon\"-rechten."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem acesso ao microfone, não poderá ouvir áudio durante a chamada. Conceda a permissão \"Microfone\" a $appName."
          }
        }
      }
    },
    "main.notice.microphone.title" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
