    "main.settings.noConnectionDialog.message" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Diese Einstellung kann nicht geändert werden, wenn du nicht mit dem Internet verbunden bist.\t Bitte überprüfe deine WLAN- oder mobile Datenverbindung und versuche es erneut."
