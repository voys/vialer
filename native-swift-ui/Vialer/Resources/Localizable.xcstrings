    },
    "main.settings.list.advancedSettings.troubleshooting.description" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Passe diese Einstellungen nur an, wenn du versuchst, Probleme zu lösen. Jegliche Änderungen können neue Probleme verursachen, also bitte mit Vorsicht verwenden."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only adjust these settings when trying to solve any issues. Any changes might cause new issues, so please use with caution."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta estos parámetros sólo cuando intentes resolver algún problema. Cualquier cambio podría causar nuevos problemas, así que utilízalos con precaución."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N'ajustez ces paramètres que lorsque vous essayez de résoudre des problèmes. Toute modification peut entraîner de nouveaux problèmes, veuillez donc l'utiliser avec prudence."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas deze instellingen alleen aan als je problemen probeert op te lossen. Aanpassingen kunnen leiden tot nieuwe problemen, dus wees voorzichtig."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste estas definições apenas quando estiver a tentar resolver algum problema. Qualquer alteração poderá causar novos problemas, pelo que deve ser efetuada com cuidado."
          }
        }
      }
    },
