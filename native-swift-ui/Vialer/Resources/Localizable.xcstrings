    "main.notice.phoneAndMicrophone.content(String appName)" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Ohne die Anruf- und Mikrofonerlaubnis kannst du keine Anrufe tätigen.\t Bitte aktiviere die „Telefon“- und „Mikrofon“-Erlaubnis  für $appName."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without the call and microphone permission, you cannot make calls. Please allow \"Phone\" and \"Microphone\" permission for $appName."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin el permiso de \"Teléfono\" y \"Micrófono\", no podrás realizar llamadas. Por favor, acepta el permiso \"Teléfono\" y \"Micrófono\" para $appName."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans l'autorisation d'appel et de microphone, vous ne pouvez pas passer d'appels. Veuillez autoriser les autorisations \"Téléphone\" et \"Microphone\" pour $appName."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder toegang tot telefonie en de microfoon kan je niet bellen. Graag $appName toegang geven tot de \"Telefoon\" en \"Microfoon\"-rechten."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem a permissão de chamada e de microfone, não é possível efetuar chamadas. Conceda a permissão \"Telefone\" e \"Microfone\" para $appName."
          }
        }
      }
    },
