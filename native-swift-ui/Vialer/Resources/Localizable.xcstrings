    "main.survey.helpUs.content(int questionCount)" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Möchtest du helfen, die App zu verbessern? Du kannst dies tun, indem du $questionCount short ${_plural(questionCount, one: 'question', many: 'questions')} beantwortest."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Would you like to help improve the app? You can do so by answering $questionCount short ${_plural(questionCount, one: 'question', many: 'questions')}."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quieres ayudar a mejorar la aplicación? Puedes hacerlo respondiendo $questionCount short ${_plural(questionCount, one: 'pregunta', many: 'preguntas')}."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Souhaitez-vous aider à améliorer l'app? Vous pouvez le faire en répondant à $questionCount short ${_plural(questionCount, one: 'question', many: 'questions')}."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wil je helpen om de app beter te maken? Je kunt dit doen door $questionCount korte ${_plural(questionCount, one: 'vraag', many: 'vragen')} te beantwoorden."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gostaria de ajudar a melhorar a aplicação? Pode fazê-lo ao responder a $questionCount short ${_plural(questionCount, one: 'question', many: 'questions')}."
          }
        }
      }
    },
