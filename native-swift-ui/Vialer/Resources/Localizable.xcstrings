    "main.survey.messagingApps.appInsights.description" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Wir würden gerne wissen, welche Messaging-Apps unsere Kunden nutzen. Mit Ihrem Einverständnis scannen wir einmalig nach diesen Apps auf Ihrem Gerät.\n\nWir können nur den Namen der Apps sehen und haben keinen Zugriff auf Nachrichten oder Inhalte."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We’d like to know which messaging apps our customers use. With your consent, we will scan for these apps on your device, just once.\n\nWe can only see the name of the apps and won’t have access to messages or content."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos gustaría saber qué aplicaciones de mensajería utilizan nuestros clientes. Con tu consentimiento, buscaremos estas aplicaciones en tu dispositivo, solo una vez.\n\nSolo podremos ver el nombre de las aplicaciones y no tendremos acceso a los mensajes ni al contenido."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous aimerions savoir quelles applications de messagerie nos clients utilisent. Avec votre accord, nous rechercherons ces applications sur votre appareil, une seule fois.\n\nNous ne pourrons voir que le nom des applications et n'aurons pas accès aux messages ou au contenu."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We willen graag weten welke communicatie apps onze klanten gebruiken. Met jouw toestemming scannen we eenmalig naar deze apps op jouw telefoon.\n\nWe zien alleen de naam van de apps en hebben geen toegang tot berichten of inhoud."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gostaríamos de saber quais as aplicações de mensagens que os nossos clientes utilizam. Com o seu consentimento, iremos procurar estas aplicações no seu dispositivo, apenas uma vez.\n\nApenas podemos ver o nome das aplicações e não teremos acesso a mensagens ou conteúdos."
          }
        }
      }
    },
    "main.survey.messagingApps.appInsights.title" : {
      "localizations" : {
