    "main.call.error.callThrough.mobile.noMobileNumber" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Die App verwendet deine Mobilnummer, um Anrufe zu tätigen, aber sie wurde noch nicht zu deinem Account hinzugefügt. Bitte wende dich an deinen Anbieter, da nur er deine Mobilnummer zu deinem Konto hinzufügen kann."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app uses your mobile number to call, but it has not been added to your account yet. Please contact your provider, as only they can add your mobile number to your account."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La aplicación utiliza tu número de móvil para llamar, pero aún no se ha añadido a tu cuenta. Ponte en contacto con tu proveedor, ya que solo él puede añadir tu número de móvil a tu cuenta."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app utilise votre numéro de portable pour appeler, mais il n'a pas encore été ajouté à votre compte. Veuillez contacter votre fournisseur, car lui seul peut ajouter votre numéro de portable à votre compte."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De app gebruikt je mobiele nummer om te bellen, maar deze is nog niet toegevoegd aan je account. Graag contact opnemen met je provider, aangezien alleen zij je mobiele nummer aan je account toe kunnen voegen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A aplicação utiliza o seu número de telefone para efetuar chamadas, mas este ainda não foi adicionado à sua conta. Contacte o seu fornecedor, pois é o único que pode adicionar o seu número de telemóvel à sua conta."
          }
        }
      }
    },
