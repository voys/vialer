      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Die Kontakte aus deinem Telefon sind fast verfügbar, bitte warte einen Moment. Wenn viele Kontakte auf deinem Telefon gespeichert sind, kann es etwas länger dauern."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The contacts from your phone are almost available, please wait a moment. If there are a lot of contacts stored on your phone, it may take a little longer."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los contactos de tu teléfono están casi disponibles, por favor espera un momento. Si hay muchos contactos almacenados en tu teléfono, puede tardar un poco más."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les contacts de votre téléphone sont presque disponibles, veuillez patienter un instant. S'il y a beaucoup de contacts stockés sur votre téléphone, cela peut prendre un peu plus de temps."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De contacten van je telefoon zijn bijna beschikbaar, nog even geduld. Als je veel contacten op je telefoon hebt staan, kan het wat langer duren."
