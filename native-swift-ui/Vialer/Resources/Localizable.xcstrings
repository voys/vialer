    "onboarding.twoFactor.wrongCode" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Der von dir eingegebene (Backup-) Code ist nicht korrekt oder nicht mehr gültig. Bitte überprüfe deine Angaben und versuche es erneut."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The (backup) code you entered is not correct or is no longer valid. Please check and try again."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El código (de reserva) que has introducido no es correcto o ya no es válido. Compruébalo e inténtalo de nuevo."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le code (de secours) que vous avez saisi n'est pas correct ou n'est plus valide. S'il vous plaît, vérifiez et essayez à nouveau."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ingevoerde (back-up)code is niet correct of niet meer geldig. Controleer op eventuele fouten en probeer het nog een keer."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O código (de segurança) que introduziu está incorreto ou já não é válido. Verifique e tente novamente."
          }
        }
      }
    },
    "onboarding.voicemail.description" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Bitte beachte, dass deine Mobiltelefonnummer gegebenenfalls in der standardmäßigen Voicemail-Nachricht aufgeführt werden kann, wenn du deine Voicemail nicht eingerichtet hast.\nWenn du nicht verfügbar bist,  wird sie an Personen weitergegeben, die dich über deine Geschäftsnummer erreichen möchten."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please be aware that if you have not set up your voicemail,  your mobile phone number may be mentioned in the default voicemail message.\nThis will be shared with people reaching you through your business number when you are not available."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten en cuenta que si no has configurado tu buzón de voz, tu número de teléfono móvil puede mencionarse en el mensaje predeterminado del buzón de voz.\nEsto se compartirá con las personas que se pongan en contacto contigo a través de tu número de empresa cuando no estés disponible."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez noter que si vous n'avez pas configuré votre messagerie vocale, votre numéro de téléphone mobile peut être mentionné dans le message vocal par défaut.\nCelle-ci sera partagée avec les personnes qui vous contactent via votre numéro d'entreprise lorsque vous n'êtes pas disponible."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd er rekening mee dat als je jouw voicemail niet hebt ingesteld, het kan zijn dat jouw mobiele nummer wordt genoemd in de standaard voicemailmelding.\nDeze wordt afgespeeld wanneer je op jouw zakelijke nummer wordt gebeld en niet beschikbaar bent."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenha em atenção que, se não tiver configurado o seu correio de voz, o seu número de telefone poderá ser mencionado na mensagem de correio de voz predefinida.\nEste número será partilhado com as pessoas que o contactarem através do seu número empresarial quando estiver indisponível."
          }
        }
      }
    },
