    "main.temporaryRedirect.actions.setupRedirect.description" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Alle eingehenden Anrufe für das Unternehmen vorübergehend weiterleiten und Anrufplan/pläne und Geschäftszeiten überspringen."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temporarily redirect all incoming calls for the organization and skip dial plan(s) and opening hours."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redirigir temporalmente todas las llamadas entrantes para la organización y omitir los planes de marcación y los horarios de apertura."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redirigez temporairement tous les appels entrants pour l'organisation et ignorez les plans de routage et les heures d'ouverture."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leid alle inkomende oproepen voor de organisatie tijdelijk om en sla belplan(nen) en openingstijden over."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redirecionar temporariamente todas as chamadas recebidas da organização e ignorar o(s) plano(s) de marcação e o horário de funcionamento."
          }
        }
      }
    },
