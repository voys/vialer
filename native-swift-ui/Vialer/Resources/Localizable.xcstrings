    "main.contacts.sharedContacts.form.confirmationDialog.deleteContactDialogContent(String contactName)" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "$contactName wird aus den Kontakten deiner Kollegen und deinen eigenen gemeinsamen Kontakten gelöscht."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$contactName will be deleted from your colleagues' and your shared contacts."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$contactName se eliminará de los contactos de tus compañeros y de tus contactos compartidos."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$contactName sera supprimée des contacts de vos collègues et de vos contacts partagés."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$contactName wordt zowel uit de gedeelde contacten van je collega's als die van jezelf verwijderd."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$contactName será eliminado dos contactos partilhados dos seus colegas e dos seus contactos partilhados."
          }
        }
      }
    },
