    "main.notice.noGooglePlayServices.content" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Dein Telefon unterstützt die Google Play Services nicht und kann daher keine eingehenden Anrufe empfangen."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your phone does not support Google Play Services and therefore will be unable to receive incoming calls."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu teléfono no es compatible con Google Play Services y, por lo tanto, no podrá recibir llamadas entrantes."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre téléphone ne prend pas en charge les services Google Play et ne peut donc pas recevoir d'appels entrants."
          }
