    "main.settings.feedback.logs(String appName)" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Möchtest du auch deine $appName-App-Aktivität senden? Auf diese Weise hilfst du unseren Entwicklern, auftretende Probleme schneller zu lösen."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
