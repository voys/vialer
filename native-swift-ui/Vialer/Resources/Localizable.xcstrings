    "main.settings.list.calling.useMobileNumberAsFallback.description(String mobileNumber)" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Wenn diese Option aktiviert ist, werden Ihre Mobilnummer ($mobileNumber) und Ihr Netz verwendet, wenn ein eingehender VoIP-Anruf nicht möglich ist. Dies verursacht zusätzliche Kosten zu Ihren Lasten."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, your mobile number ($mobileNumber) and network will be used when an incoming VoIP call is not possible. This will incur additional costs at your expense."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando se activa, tu número de móvil ($mobileNumber) y su red se utilizará cuando una llamada VoIP entrante no es posible. Esto incurrirá en costes adicionales a tu cargo."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est activée, votre numéro mobile ($mobileNumber) et votre réseau seront utilisés lorsque l'appel VoIP entrant n'est pas possible. Cela entraînera des frais supplémentaires à votre charge."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als deze optie aan staat, dan verlopen gesprekken via je mobiele nummer ($mobileNumber) als het niet lukt om verbinding te maken met je VoIP-account. Deze instelling brengt extra kosten met zich mee."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, o seu número de telefone ($mobileNumber) e a rede serão utilizados quando não for possível receber uma chamada VoIP. Isto implicará custos adicionais a seu cargo."
          }
        }
      }
    },
    "main.settings.list.calling.useMobileNumberAsFallback.title" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Mobilnummer anrufen, wenn eingehender VoIP-Anruf fehlschlägt"
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Call mobile number if incoming VoIP call fails"
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llamar al número del móvil si falla la llamada VoIP entrante"
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appeler le numéro de téléphone mobile si l'appel VoIP entrant échoue"
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik mobiele nummer wanneer er geen VoIP-gesprek opgezet kan worden"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chamar o número de telefone se a chamada VoIP de entrada falhar"
          }
        }
      }
    },
    "main.settings.list.calling.useVoip.description" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Mit VoIP telefonierst du über das Internet, das dein Datenpaket nutzt. Wenn VoIP deaktiviert ist, werden Anrufe über die normale Telefon-App getätigt, und es fallen die Kosten für den Dienst deines Telefonanbieters an."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With VoIP you call via internet which uses your data bundle. If VoIP is disabled, calls go through the regular phone app and your call carrier service costs apply."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con VoIP llamas a través de Internet, que utiliza tu paquete de datos. Si VoIP está desactivado, las llamadas se realizan a través de la aplicación de teléfono normal y se aplican los costes del servicio de tu operador de llamadas."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec le VoIP, vous passez des appels via Internet en utilisant votre forfait de données. Si le VoIP est désactivé, les appels passent par l'application téléphone classique et les frais de votre opérateur s'appliquent."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met VoIP bel je via internet waarvoor je databundel wordt gebruikt. Als VoIP uitstaat, wordt een gesprek opgezet via de gewone telefoon-app. De reguliere abonnementskosten van je mobiele nummer zijn dan van toepassing."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com o VoIP, as chamadas são efectuadas através da Internet, que utiliza o seu pacote de dados. Se o VoIP estiver desativado, as chamadas são efetuadas através da aplicação telefónica normal e são aplicados os custos de serviço do seu operador de chamadas."
          }
        }
      }
    },
    "main.settings.list.calling.useVoip.title" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "VoIP verwenden"
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use VoIP"
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizar VoIP"
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser VoIP"
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik VoIP"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizar VoIP"
          }
        }
      }
    },
    "main.settings.list.debug.remoteLogging.description" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Wenn du dich dafür entscheidest, deine App-Aktivität automatisch zu protokollieren, können unsere Entwickler und unser Support-Team dir bei Bedarf effizienter helfen."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By choosing to automatically log your app activity, our developers and support team will be able to help you more efficiently if needed."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si eliges registrar automáticamente la actividad de tu aplicación, nuestros desarrolladores y el equipo de asistencia podrán ayudarte de forma más eficaz en caso necesario."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En choisissant d'enregistrer automatiquement l'activité de votre app, nos développeurs et notre équipe de support pourront vous aider plus efficacement si nécessaire."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Door ervoor te kiezen om je app-activiteit te delen, kunnen onze ontwikkelaars en het ondersteuningsteam je beter helpen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao optar por registar automaticamente a sua atividade da aplicação, os nossos programadores e a equipa de apoio poderão ajudar de forma mais eficiente, se necessário."
          }
        }
      }
    },
    "main.settings.list.debug.remoteLogging.sendToRemoteDialog.confirm" : {
      "localizations" : {
