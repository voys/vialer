    "main.settings.list.calling.ignoreBatteryOptimizations.description" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Diese Anwendung wird nicht länger durch die Android-Akku-Optimierung eingeschränkt, wodurch die Zuverlässigkeit eingehender Anrufe erhöht wird. Es wird dringend empfohlen, dies zu aktivieren."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This application will no longer be restricted by Android battery optimization, increasing the reliability of incoming calls. It is highly recommended that this is enabled."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta aplicación ya no estará restringida por la optimización de la batería de Android, aumentando la fiabilidad de las llamadas entrantes. Se recomienda encarecidamente activar esta opción."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette application ne sera plus restreinte par l'optimisation de la batterie d'Android, ce qui améliore la fiabilité des appels entrants. Il est fortement recommandé d'activer cette option."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze app wordt niet langer beperkt door Android batterij-optimalisatie, waardoor de betrouwbaarheid van inkomende gesprekken wordt verhoogd. Het wordt sterk geadviseerd dit in te schakelen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta aplicação deixará de ser limitada pela otimização da bateria do Android, o que aumenta a fiabilidade das chamadas recebidas. Recomenda-se vivamente que esta opção esteja ativada."
          }
        }
      }
    },
