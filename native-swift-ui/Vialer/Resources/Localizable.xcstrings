    "connectivity.noConnection.message" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Du scheinst nicht mit dem Internet verbunden zu sein. Bitte überprüfe deine WLAN- oder mobile Datenverbindung und versuche es erneut."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You don't seem to be connected to the internet. Please check your WiFi or mobile data connection and try again."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que no estás conectado a Internet. Comprueba tu conexión WiFi o de datos móviles e inténtalo de nuevo."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne semblez pas être connecté à Internet. Veuillez vérifier votre connexion Wi-Fi ou mobiles et réessayer."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het lijkt erop dat je geen verbinding hebt met internet. Controleer je wifi- of mobiele dataverbinding en probeer het opnieuw."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que não está ligado à Internet. Verifique a sua ligação Wi-Fi ou de dados móveis e tente novamente."
          }
        }
      }
    },
