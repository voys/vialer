    "main.colleagues.websocketUnreachableNotice.content(String appName)" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "$appName versucht den Status deiner Kollegen abzurufen. Aktualisieren diese Seite in Kürze. Ein Anruf ist weiterhin möglich."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$appName is trying to retrieve your colleagues statuses. Please refresh this page in a bit. It is still possible to make a call."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$appName está intentando recuperar los estados de sus colegas. Por favor, actualiza esta página en unos instantes. Todavía es posible realizar llamadas."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$appName essaie de récupérer les statuts de vos collègues. Veuillez actualiser cette page dans un instant. Il est toujours possible de passer un appel."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$appName probeert de statussen van je collega's op te halen. Ververs deze pagina op een later moment. Het is nog wel mogelijk om een gesprek te starten."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$appName está a tentar obter o estado dos seus colegas. Atualize esta página em alguns momentos. Ainda é possível efetuar uma chamada."
          }
        }
      }
    },
