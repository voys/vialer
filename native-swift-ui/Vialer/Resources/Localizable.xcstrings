    "main.notice.bluetoothConnect.content(String appName)" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Ohne Bluetooth-Erlaubnis kann $appName deine angeschlossenen Bluetooth-Geräte nicht erkennen und bei Anrufen nicht verwenden."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without bluetooth permission, $appName will not be able to detect and use your connected bluetooth devices during calls."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin el permiso bluetooth $appName no podrá detectar y utilizar tus dispositivos bluetooth conectados durante las llamadas."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans autorisation Bluetooth, $appName ne pourra pas détecter et utiliser vos appareils Bluetooth connectés pendant les appels."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder toestemming tot bluetooth kan $appName niet je bluetooth apparaten detecteren en gebruiken tijdens een gesprek."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem a permissão bluetooth, $appName não poderá detetar e utilizar os seus dispositivos bluetooth ligados durante as chamadas."
          }
        }
      }
    },
    "main.notice.bluetoothConnect.title" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Keine Bluetooth-Erlaubnis"
          }
        },
        "en-US" : {
          "stringUnit" : {
