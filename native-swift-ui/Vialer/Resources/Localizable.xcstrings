    "main.notice.phone.content(String appName)" : {
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "stale",
            "value" : "Ohne die Telefonerlaubnis kannst du keine Anrufe tätigen. Bitte aktiviere die „Telefon“-Erlaubnis für $appName."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without the Phone permission, you cannot make calls. Please allow \"Phone\" permission for $appName."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin el permiso \"Teléfono\", no podrá realizar llamadas. Por favor, permita el permiso \"Teléfono\" para $appName."
          }
        },
        "fr-FR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans l'autorisation Téléphone, vous ne pouvez pas passer d'appels. Veuillez autoriser l'autorisation \"Téléphone\" pour $appName."
          }
        },
        "nl-NL" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder toegang tot telefonie kan je niet bellen. Graag $appName toegang geven tot de \"Telefonie\"-rechten."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem a permissão Telefone, não é possível efetuar chamadas. Conceda a permissão \"Telefone\" a $appName."
          }
        }
      }
    },
    "main.notice.phone.title" : {
